{
  "name": "axon-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Axon UI: React component library with forms, AI chat, charts and data table packages.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "storybook": "pnpm --filter @axonui/docs storybook",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "size": "turbo run size",
    "verify:treeshake": "node tooling/verify-treeshake.mjs",
    "test:a11y": "playwright test tests/a11y",
    "test:visual": "playwright test tests/visual",
    "verify:package": "node tooling/verify-dist.mjs && pnpm -r --filter \"./packages/*\" exec publint --strict"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@changesets/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@size-limit/preset-small-lib": "catalog:",
    "@storybook/react": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "axe-core": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "jest-axe": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "size-limit": "catalog:",
    "tsup": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
