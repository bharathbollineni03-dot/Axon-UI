{
  "name": "@axonui/chat",
  "version": "0.1.0",
  "description": "Axon UI AI chat window and related components.",
  "keywords": [
    "react",
    "react-component",
    "axon-ui",
    "accessibility",
    "chat",
    "ai",
    "llm",
    "streaming",
    "markdown"
  ],
  "homepage": "https://github.com/bharathbollineni03-dot/Axon-UI/tree/main/packages/chat#readme",
  "bugs": {
    "url": "https://github.com/bharathbollineni03-dot/Axon-UI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bharathbollineni03-dot/Axon-UI.git",
    "directory": "packages/chat"
  },
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "size-limit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@axonui/core": "workspace:*",
    "@axonui/forms": "workspace:*",
    "@axonui/theme": "workspace:*",
    "@tanstack/react-virtual": "catalog:",
    "highlight.js": "catalog:",
    "react-markdown": "catalog:",
    "remark-gfm": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
