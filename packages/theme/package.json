{
  "name": "@axonui/theme",
  "version": "0.1.0",
  "description": "Axon UI design tokens, ThemeProvider and light/dark mode.",
  "keywords": [
    "react",
    "react-component",
    "axon-ui",
    "accessibility",
    "design tokens",
    "theme",
    "dark mode",
    "css variables"
  ],
  "homepage": "https://github.com/bharathbollineni03-dot/Axon-UI/tree/main/packages/theme#readme",
  "bugs": {
    "url": "https://github.com/bharathbollineni03-dot/Axon-UI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bharathbollineni03-dot/Axon-UI.git",
    "directory": "packages/theme"
  },
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsx scripts/generate-css.ts && tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:css": "tsx scripts/generate-css.ts",
    "size": "size-limit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
