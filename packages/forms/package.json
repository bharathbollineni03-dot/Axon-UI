{
  "name": "@axon/forms",
  "version": "0.0.0",
  "description": "Axon UI form engine and prebuilt forms.",
  "keywords": [
    "react",
    "react-component",
    "axon-ui",
    "accessibility",
    "forms",
    "react-hook-form",
    "zod",
    "validation",
    "authentication"
  ],
  "homepage": "https://github.com/bharathbollineni03-dot/Axon-UI/tree/main/packages/forms#readme",
  "bugs": {
    "url": "https://github.com/bharathbollineni03-dot/Axon-UI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bharathbollineni03-dot/Axon-UI.git",
    "directory": "packages/forms"
  },
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "size-limit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@axon/core": "workspace:*",
    "@axon/theme": "workspace:*",
    "@hookform/resolvers": "catalog:",
    "react-hook-form": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
